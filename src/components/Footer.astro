---
import { profile } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 py-8 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-4 text-sm text-slate-600 sm:flex-row sm:px-6 dark:text-slate-400"
  >
    <p>© {year} {profile.name}. Hecho con Astro y Tailwind CSS.</p>
    <a href="#inicio" class="font-medium text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300">
      Volver arriba ↑
    </a>
  </div>
</footer>
