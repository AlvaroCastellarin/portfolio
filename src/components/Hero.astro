---
import { Image } from 'astro:assets';
import { profile } from '../data/site';
import foto from '../assets/foto-alvaro.jpg';

const [first, ...rest] = profile.name.split(' ');
const btn = 'inline-block border border-acc px-5 py-3 font-mono text-sm font-semibold transition-colors';
---

<section id="inicio" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
  <div class="grid items-center gap-12 md:grid-cols-[1.4fr_1fr]">
    <div class="reveal">
      <p class="font-mono text-sm text-acc sm:text-base">
        {first.toLowerCase()}@uai:~$ <span class="text-acc-2">whoami</span>
      </p>
      <h1 class="mt-4 text-5xl leading-none font-extrabold tracking-tighter sm:text-6xl lg:text-7xl">
        {first}<br />{rest.join(' ')}
      </h1>
      <p class="mt-4 font-mono text-lg text-acc sm:text-2xl">
        &gt; {profile.role}<span class="cursor" aria-hidden="true"></span>
      </p>
      <p class="mt-6 max-w-xl leading-relaxed text-muted sm:text-lg">{profile.tagline}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#proyectos" class={`${btn} bg-acc text-on-acc hover:opacity-90`}>./ver-proyectos</a>
        <a href="#contacto" class={`${btn} text-acc hover:bg-acc hover:text-on-acc`}>contactarme</a>
        {
          profile.hasCv && (
            <a href={profile.cvPath} download class={`${btn} text-acc hover:bg-acc hover:text-on-acc`}>
              cv.pdf <span aria-hidden="true">↓</span>
              <span class="sr-only">(descargar CV en PDF)</span>
            </a>
          )
        }
      </div>
    </div>

    <figure class="reveal mx-auto w-full max-w-sm overflow-hidden rounded-xl border border-line bg-panel">
      <div class="flex items-center gap-2 border-b border-line px-3 py-2.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-2 font-mono text-xs text-muted">foto_perfil.jpg</span>
      </div>
      <Image
        src={foto}
        alt={`Foto de ${profile.name} sonriendo`}
        width={400}
        height={400}
        loading="eager"
        fetchpriority="high"
        class="aspect-square w-full object-cover"
      />
      <figcaption class="pulse px-4 py-3 font-mono text-sm text-acc">disponible para pasantía</figcaption>
    </figure>
  </div>
</section>
