---
import { profile } from '../data/site';

const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<section id="inicio" class="mx-auto max-w-5xl px-4 py-20 sm:px-6 md:py-28">
  <div class="flex flex-col-reverse items-center gap-10 md:flex-row md:justify-between">
    <div class="reveal text-center md:text-left">
      <p class="mb-3 font-semibold text-indigo-700 dark:text-indigo-400">Hola, soy</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
        {profile.name}
      </h1>
      <p class="mt-3 text-xl font-medium text-slate-600 sm:text-2xl dark:text-slate-300">{profile.role}</p>
      <p class="mt-5 max-w-xl text-base text-slate-600 sm:text-lg dark:text-slate-400">{profile.tagline}</p>

      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href="#proyectos"
          class="rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-indigo-700"
        >
          Ver proyectos
        </a>
        <a
          href="#contacto"
          class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-800 transition hover:border-indigo-600 hover:text-indigo-700 dark:border-slate-700 dark:text-slate-200 dark:hover:border-indigo-400 dark:hover:text-indigo-300"
        >
          Contactarme
        </a>
        {
          profile.hasCv && (
            <a
              href={profile.cvPath}
              download
              class="rounded-lg px-5 py-3 font-semibold text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
            >
              Descargar CV (PDF)
            </a>
          )
        }
      </div>
    </div>

    <div
      class="reveal flex h-40 w-40 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-5xl font-bold text-white shadow-lg ring-4 ring-indigo-100 sm:h-52 sm:w-52 sm:text-6xl dark:ring-indigo-950"
      role="img"
      aria-label={`Avatar con las iniciales de ${profile.name}`}
    >
      {initials}
    </div>
  </div>
</section>
