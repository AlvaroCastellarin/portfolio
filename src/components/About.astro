---
import { profile, skills } from '../data/site';
import SectionTitle from './SectionTitle.astro';

const fileName = (category: string) =>
  category
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/\s+/g, '_') + '.json';
---

<section id="sobre-mi" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
  <SectionTitle num="01" slug="sobre-mí" title="Quién soy" />

  <div class="reveal mt-6 max-w-3xl space-y-3 text-lg leading-relaxed text-muted">
    {profile.bio.map((p) => <p>{p}</p>)}
  </div>

  <h3 class="reveal mt-12 font-mono text-acc">$ ls ./habilidades</h3>
  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div class="reveal overflow-hidden rounded-xl border border-line bg-panel">
          <h4 class="border-b border-line px-4 py-2.5 font-mono text-xs text-muted">
            <span class="text-ink">{group.category}</span> · {fileName(group.category)}
          </h4>
          <ul class="flex flex-wrap gap-2 p-4">
            {group.items.map((item) => (
              <li class="rounded-md border border-line px-2.5 py-1 font-mono text-xs text-acc-2">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
