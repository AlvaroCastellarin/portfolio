---
import { projects } from '../data/site';
---

<section id="proyectos" class="py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="reveal text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Proyectos</h2>
    <p class="reveal mt-3 text-slate-600 dark:text-slate-400">
      Algunos trabajos de la facultad y proyectos personales.
    </p>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.map((p) => (
          <li class="reveal flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
            <article class="flex h-full flex-col">
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{p.title}</h3>
              <p class="mt-3 flex-1 text-slate-600 dark:text-slate-400">{p.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías usadas">
                {p.tech.map((t) => (
                  <li class="rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200">
                    {t}
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex gap-4 text-sm font-semibold">
                {p.repo && (
                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
                  >
                    Repositorio<span class="sr-only"> de {p.title} (abre en una pestaña nueva)</span>
                  </a>
                )}
                {p.demo && (
                  <a
                    href={p.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
                  >
                    Demo<span class="sr-only"> de {p.title} (abre en una pestaña nueva)</span>
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
