---
import { projects } from '../data/site';
import SectionTitle from './SectionTitle.astro';
---

<section id="proyectos" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
  <SectionTitle num="02" slug="proyectos" title="Cosas que construí" />

  <ul class="mt-10 grid gap-5 md:grid-cols-2">
    {
      projects.map((p) => (
        <li class="reveal flex">
          <article class="flex w-full flex-col rounded-xl border border-line bg-panel p-6 transition hover:-translate-y-1 hover:border-acc">
            <h3 class="text-xl font-extrabold tracking-tight">{p.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-acc-2" aria-label="Tecnologías usadas">
              {p.tech.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="mt-5 flex gap-5 font-mono text-sm">
              {p.repo && (
                <a href={p.repo} target="_blank" rel="noopener noreferrer" class="text-acc hover:underline">
                  <span aria-hidden="true">→ </span>repo
                  <span class="sr-only"> de {p.title} (abre en una pestaña nueva)</span>
                </a>
              )}
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener noreferrer" class="text-acc hover:underline">
                  <span aria-hidden="true">→ </span>demo
                  <span class="sr-only"> de {p.title} (abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
