---
import { profile } from '../data/site';

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-500 focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/30 focus:outline-none aria-[invalid=true]:border-red-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-400 dark:aria-[invalid=true]:border-red-400';
const errorClass = 'mt-1 min-h-5 text-sm text-red-700 dark:text-red-400';
---

<section id="contacto" class="bg-slate-50 py-20 dark:bg-slate-900/50">
  <div class="mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 md:grid-cols-2">
    <div class="reveal">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Contacto</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        ¿Tenés una propuesta o querés charlar? Escribime y te respondo a la brevedad.
      </p>
      <ul class="mt-8 space-y-4">
        <li>
          <span class="block text-sm text-slate-500 dark:text-slate-400">Email</span>
          <a
            href={`mailto:${profile.email}`}
            class="font-semibold break-all text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
          >
            {profile.email}
          </a>
        </li>
        <li>
          <span class="block text-sm text-slate-500 dark:text-slate-400">GitHub</span>
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
          >
            {profile.github.replace('https://', '')}
          </a>
        </li>
        {
          profile.linkedin && (
            <li>
              <span class="block text-sm text-slate-500 dark:text-slate-400">LinkedIn</span>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold break-all text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
              >
                {profile.linkedin.replace('https://www.', '')}
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <form id="contact-form" class="reveal space-y-2" novalidate data-email={profile.email}>
      <div>
        <label for="name" class="text-sm font-medium text-slate-800 dark:text-slate-200">Nombre</label>
        <input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" class={inputClass} aria-describedby="name-error" />
        <p id="name-error" class={errorClass} aria-live="polite"></p>
      </div>
      <div>
        <label for="email" class="text-sm font-medium text-slate-800 dark:text-slate-200">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="120" class={inputClass} aria-describedby="email-error" />
        <p id="email-error" class={errorClass} aria-live="polite"></p>
      </div>
      <div>
        <label for="message" class="text-sm font-medium text-slate-800 dark:text-slate-200">Mensaje</label>
        <textarea id="message" name="message" rows="5" required minlength="10" maxlength="1000" class={inputClass} aria-describedby="message-error"></textarea>
        <p id="message-error" class={errorClass} aria-live="polite"></p>
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-indigo-700 sm:w-auto"
      >
        Enviar mensaje
      </button>
      <p id="form-status" class="min-h-6 text-sm text-emerald-700 dark:text-emerald-400" role="status"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v.length < 2 ? 'Ingresá tu nombre (mínimo 2 caracteres).' : ''),
    email: (v) => (!v ? 'Ingresá tu email.' : !EMAIL_RE.test(v) ? 'El email no tiene un formato válido.' : ''),
    message: (v) => (v.length < 10 ? 'El mensaje debe tener al menos 10 caracteres.' : ''),
  };

  const validateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const msg = rules[field.name](field.value.trim());
    document.getElementById(`${field.name}-error`)!.textContent = msg;
    field.setAttribute('aria-invalid', msg ? 'true' : 'false');
    return !msg;
  };

  const fields = Object.keys(rules).map(
    (n) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement,
  );
  fields.forEach((f) =>
    f.addEventListener('blur', () => {
      if (f.value) validateField(f);
    }),
  );
  fields.forEach((f) =>
    f.addEventListener('input', () => {
      if (f.getAttribute('aria-invalid') === 'true') validateField(f);
    }),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.textContent = '';
    const results = fields.map(validateField);
    const firstInvalid = fields[results.indexOf(false)];
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }
    const [name, email, message] = fields.map((f) => f.value.trim());
    const subject = encodeURIComponent(`Contacto desde el portfolio: ${name}`);
    const body = encodeURIComponent(`${message}\n\n${name} <${email}>`);
    window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    status.textContent = '¡Listo! Se abrió tu cliente de correo con el mensaje para enviar.';
    form.reset();
    fields.forEach((f) => f.removeAttribute('aria-invalid'));
  });
</script>
