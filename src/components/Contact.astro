---
import { profile } from '../data/site';
import SectionTitle from './SectionTitle.astro';

const inputClass =
  'mt-1.5 block w-full rounded-md border border-line bg-bg px-3 py-2 text-ink placeholder:text-muted focus:border-acc focus:outline-none aria-[invalid=true]:border-[#d1242f] dark:aria-[invalid=true]:border-[#ff7b72]';
const labelClass = 'font-mono text-sm text-acc';
const errorClass = 'mt-1 min-h-5 text-sm text-[#d1242f] dark:text-[#ff7b72]';
const linkClass = 'break-all font-mono text-ink transition-colors hover:text-acc';
const contacts = [
  { label: 'email', href: `mailto:${profile.email}`, text: profile.email, external: false },
  { label: 'github', href: profile.github, text: profile.github.replace('https://', ''), external: true },
  ...(profile.linkedin
    ? [{ label: 'linkedin', href: profile.linkedin, text: profile.linkedin.replace('https://www.', ''), external: true }]
    : []),
];
---

<section id="contacto" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
  <SectionTitle num="03" slug="contacto" title="¿Hablamos?" />

  <div class="mt-8 grid gap-10 md:grid-cols-2">
    <div class="reveal">
      <p class="max-w-md text-lg leading-relaxed text-muted">
        ¿Tenés una propuesta de pasantía o querés charlar? Escribime y te respondo a la brevedad.
      </p>
      <ul class="mt-8 space-y-5">
        {
          contacts.map((c) => (
            <li>
              <span class="block font-mono text-xs text-muted">$ echo ${c.label}</span>
              <a
                href={c.href}
                class={linkClass}
                {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="text-acc" aria-hidden="true">→ </span>{c.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal overflow-hidden rounded-xl border border-line bg-panel">
      <div class="flex items-center gap-2 border-b border-line px-3 py-2.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-2 font-mono text-xs text-muted">nuevo_mensaje.sh</span>
      </div>
      <form id="contact-form" class="space-y-2 p-5" novalidate data-email={profile.email}>
        <div>
          <label for="name" class={labelClass}>nombre</label>
          <input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" class={inputClass} aria-describedby="name-error" />
          <p id="name-error" class={errorClass} aria-live="polite"></p>
        </div>
        <div>
          <label for="email" class={labelClass}>email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="120" class={inputClass} aria-describedby="email-error" />
          <p id="email-error" class={errorClass} aria-live="polite"></p>
        </div>
        <div>
          <label for="message" class={labelClass}>mensaje</label>
          <textarea id="message" name="message" rows="5" required minlength="10" maxlength="1000" class={inputClass} aria-describedby="message-error"></textarea>
          <p id="message-error" class={errorClass} aria-live="polite"></p>
        </div>
        <button
          type="submit"
          class="w-full border border-acc bg-acc px-5 py-3 font-mono text-sm font-semibold text-on-acc transition hover:opacity-90 sm:w-auto"
        >
          ./enviar
        </button>
        <p id="form-status" class="min-h-6 font-mono text-sm text-acc" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v.length < 2 ? 'Ingresá tu nombre (mínimo 2 caracteres).' : ''),
    email: (v) => (!v ? 'Ingresá tu email.' : !EMAIL_RE.test(v) ? 'El email no tiene un formato válido.' : ''),
    message: (v) => (v.length < 10 ? 'El mensaje debe tener al menos 10 caracteres.' : ''),
  };

  const validateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const msg = rules[field.name](field.value.trim());
    document.getElementById(`${field.name}-error`)!.textContent = msg;
    field.setAttribute('aria-invalid', msg ? 'true' : 'false');
    return !msg;
  };

  const fields = Object.keys(rules).map(
    (n) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement,
  );
  fields.forEach((f) =>
    f.addEventListener('blur', () => {
      if (f.value) validateField(f);
    }),
  );
  fields.forEach((f) =>
    f.addEventListener('input', () => {
      if (f.getAttribute('aria-invalid') === 'true') validateField(f);
    }),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.textContent = '';
    const results = fields.map(validateField);
    const firstInvalid = fields[results.indexOf(false)];
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }
    const [name, email, message] = fields.map((f) => f.value.trim());
    const subject = encodeURIComponent(`Contacto desde el portfolio: ${name}`);
    const body = encodeURIComponent(`${message}\n\n${name} <${email}>`);
    window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    status.textContent = '¡Listo! Se abrió tu cliente de correo con el mensaje para enviar.';
    form.reset();
    fields.forEach((f) => f.removeAttribute('aria-invalid'));
  });
</script>
